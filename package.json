{
  "name": "electron-minecraft-launcher",
  "private": true,
  "version": "0.1.5",
  "description": "Moderner saisonaler Minecraft Server Launcher mit Modrinth-Integration",
  "author": "Pascal",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:vite": "vite",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "node scripts/dev.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages",
    "dist": "npm run build:electron && electron-builder --win",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:linux": "npm run build:electron && electron-builder --linux",
    "publish-app": "node scripts/publish.js"
  },
  "build": {
    "appId": "com.minecraftlauncher.app",
    "productName": "dP Launcher",
    "copyright": "Copyright © 2026 Pascal",
    "asar": true,
    "compression": "normal",
    "artifactName": "dP-Launcher-${version}-${os}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "dPandl",
      "repo": "dP-Launcher",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "main.js",
      "modpackUtils.js",
      "modResolver.js",
      "clientDefaults.js",
      "serverStore.js",
      "instanceStore.js",
      "preload.js",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "dpmcserver",
        "name": "dP Launcher Server",
        "description": "Server für den dP Launcher",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "public/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/app-icon.png",
      "target": [
        "zip"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "dP Launcher"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "lucide-react": "^1.18.0",
    "marked": "^18.1.2",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.12"
  }
}
